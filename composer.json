{
    "name": "anodyne/nova3",
    "type": "project",
    "description": "Nova 3 RPG Management",
    "keywords": [
        "cms",
        "anodyne",
        "nova",
        "rpg"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "anodyne/blade-hugeicons": "^3.1",
        "anodyne/blade-tabler-icons": "^3.0",
        "anousss007/blatui": "^1.16",
        "artesaos/seotools": "^1.3",
        "aws/aws-sdk-php": "^3.293",
        "beacon-hq/bag": "^2.0",
        "blade-ui-kit/blade-icons": "^1.0",
        "cohensive/oembed": "^0.18",
        "filament/filament": "^5.0",
        "flowframe/laravel-trend": "^0.4",
        "gehrisandro/tailwind-merge-laravel": "^1.4",
        "guzzlehttp/guzzle": "^7.2",
        "hosmelq/name-of-person": "^0.3",
        "jlorente/laravel-data-migrations": "^2.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/fortify": "^1.16",
        "laravel/framework": "^12.31",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.11",
        "laravel/tinker": "^2.10",
        "league/flysystem-path-prefixing": "^3.3",
        "livewire/flux": "2.11.1",
        "livewire/flux-pro": "2.11.1",
        "livewire/livewire": "^4.0",
        "lorisleiva/laravel-actions": "^2.1",
        "mailersend/laravel-driver": "^3.0",
        "mallardduck/blade-lucide-icons": "^1.26",
        "mchev/banhammer": "^2.4",
        "mistralys/version-parser": "^2.1",
        "nicobleiler/php-passphrase": "^2.1",
        "opcodesio/log-viewer": "^3.11",
        "ralphjsmit/laravel-filament-activitylog": "^2.0",
        "resend/resend-laravel": "^1.0",
        "santigarcor/laratrust": "^8.0",
        "spatie/eloquent-sortable": "^5.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-collection-macros": "^8.0",
        "spatie/laravel-honeypot": "^4.5",
        "spatie/laravel-html": "^3.0",
        "spatie/laravel-medialibrary": "^11.0",
        "spatie/laravel-model-states": "^2.1",
        "spatie/laravel-prefixed-ids": "^1.4",
        "spatie/laravel-ray": "^1.26",
        "staudenmeir/eloquent-has-many-deep": "^1.18",
        "staudenmeir/laravel-adjacency-list": "^1.0",
        "symfony/http-client": "^8.0",
        "symfony/mailgun-mailer": "^8.0",
        "symfony/postmark-mailer": "^8.0",
        "teamtnt/laravel-scout-tntsearch-driver": "^15.0",
        "vlucas/phpdotenv": "^5.6",
        "wire-elements/pro": "^5.0",
        "wire-elements/spotlight": "^2.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.14",
        "fakerphp/faker": "^1.14",
        "fruitcake/laravel-debugbar": "^4.1",
        "itsgoingd/clockwork": "^5.0",
        "larastan/larastan": "^3.8",
        "laravel/boost": "^2.0",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-browser": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-livewire": "^4.0",
        "pestphp/pest-plugin-stressless": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.0"
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "blade-ui-kit/blade-icons",
                "livewire-ui/spotlight"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "Nova\\": "nova/src/",
            "Nova\\Filament\\": "nova/filament/",
            "Nova\\Foundation\\": "nova/foundation/",
            "Nova\\Setup\\": "nova/setup/",
            "Addons\\": "addons/",
            "Themes\\": "themes/",
            "Database\\Factories\\": "nova/database/factories/",
            "Database\\Seeders\\": "nova/database/seeders/"
        },
        "files": [
            "nova/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Addons\\": "tests/fixtures/addons/"
        }
    },
    "scripts": {
        "clean": [
            "rm -f ./nova/bootstrap/cache/blade-icons.php",
            "rm -f ./nova/bootstrap/cache/packages.php",
            "rm -f ./nova/bootstrap/cache/services.php"
        ],
        "clean-logs": [
            "find ./storage/logs -mindepth 1 ! -name '.gitignore' -delete"
        ],
        "clean-media": [
            "find ./media/characters -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/departments -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/pages -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/samples -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/settings -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/stories -mindepth 1 ! -name '.gitignore' -delete",
            "find ./media/users -mindepth 1 ! -name '.gitignore' -delete"
        ],
        "lint": [
            "pint"
        ],
        "refactor": [
            "rector"
        ],
        "test:lint": [
            "pint --test"
        ],
        "test:refactor": [
            "rector --dry-run"
        ],
        "test:types": [
            "phpstan analyse"
        ],
        "test:type-coverage": [
            "pest --type-coverage --min=100"
        ],
        "test:arch": [
            "pest --filter=arch"
        ],
        "test:unit": [
            "pest --parallel --ci --coverage --min=100.0"
        ],
        "test:browser": [
            "php artisan dusk --bail"
        ],
        "test": [
            "@test:lint",
            "@test:refactor",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan optimize:clear --ansi",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "ralphjsmit/packages": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "flux-pro": {
            "type": "composer",
            "url": "https://composer.fluxui.dev"
        },
        "activity-log-pro": {
            "type": "composer",
            "url": "https://satis.ralphjsmit.com"
        },
        "wire-elements-pro": {
            "type": "composer",
            "url": "https://wire-elements-pro.composer.sh"
        }
    }
}
